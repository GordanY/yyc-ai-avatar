# First-run defaults; credentials are entered in the local Settings UI.
# Never commit .env.local or .amica-data/.
NEXT_PUBLIC_DEVELOPMENT_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CHATBOT_BACKEND=claude
NEXT_PUBLIC_AMICA_LIFE_ENABLED=false
NEXT_PUBLIC_VRM_HASH=/vrm/YYC_InfoDay.vrm
NEXT_PUBLIC_NAME=YYC Helper
NEXT_PUBLIC_TTS_BACKEND=openai_tts
NEXT_PUBLIC_STT_BACKEND=whisper_openai
# Optional licensed pack root, containing vrma/VRMA_01.vrma ... VRMA_07.vrma.
# Windows example: C:/Users/YourName/Downloads/VRMA_MotionPack
# AMICA_MOTION_PACK_DIR=
# Optional server network proxy for Anthropic, if needed on this network.
# HTTPS_PROXY=http://127.0.0.1:7890
